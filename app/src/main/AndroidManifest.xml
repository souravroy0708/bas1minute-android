<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Steps from Health Connect (Google Fit, Samsung Health, watches, Android 14+ phone sensor) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Optional (Profile › Import older steps): read steps saved in Health Connect before this app was installed -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Steps from the phone sensor via the Recording API (fallback) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- GPS walk / run: precise location while recording (foreground service; no background location) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Walk / run without GPS: step counter in a "health" foreground service, CPU kept awake while recording -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Map tiles: OpenStreetMap checks the connection before downloading -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Screen time, clean hours, Digital detox, App Timers and long-session nudges all come from this one
         switch. Granted by the user in Settings > Usage access. It only tells us WHICH app was open and for how
         long — never what's inside it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Voice typing in Diary and Goals. Asked only when the member first taps a mic, after an explanation.
         On only while the Listening window is open; audio is never saved or sent to us. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Digital detox STRICT MODE only (opt-in on the Detox screen): the countdown pause screen over a paused app,
         and the light foreground service that runs only while a strict detox is on. Asked only if the member
         turns Strict mode on; the normal detox never uses them. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Never ask for these. Detox and App Timers remind (notification) and judge the promise from Android's own
         usage history; a hard lock is handed to Android's Digital Wellbeing (Focus mode / app timers), which needs
         no permission from us; Strict mode (above) is the only exception, and only if chosen. tools:node="remove"
         also strips these if a library ever tries to add one. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />

    <!-- Lets the app check whether Health Connect is installed (Android 13 and older) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- "Search Google for my phone" in phone-specific help -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <!-- Circle invites go straight to WhatsApp -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- To check whether Samsung Health is installed and open it -->
        <package android:name="com.sec.android.app.shealth" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Digital detox: the messages app stays allowed (browsers are found with the https query above) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <!-- Voice typing (Diary, Goals): find the phone's speech service, the system "Speak now" screen as a
             fallback, and the Google / Speech Services apps so the help sheet can open their settings. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.tts" />
        <!-- "Set a hard limit": opens Android's own Digital Wellbeing (Google / Samsung) -->
        <package android:name="com.google.android.apps.wellbeing" />
        <package android:name="com.samsung.android.forest" />
        <!-- Apps with a launcher icon: to tell social apps apart and show their names (on this phone only) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- To skip the home-screen app when adding up screen time -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bas1Minute"
        android:usesCleartextTraffic="${cleartext}">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Bas1Minute.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Circle invite links from WhatsApp open the app and join (App Links; needs assetlinks.json on the site) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bas1minute.pythonanywhere.com" android:pathPrefix="/join/" />
                <!-- Website sign-in QR codes open the approve screen -->
                <data android:pathPrefix="/link/" />
            </intent-filter>
            <!-- From the invite web page's "Open in the app" button -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bas1minute" android:host="join" />
                <data android:host="link" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: steps, distance, streak -->
        <receiver android:name=".StepsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_steps_info" />
        </receiver>

        <!-- Share achievement images to WhatsApp, Instagram, Facebook… -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Records a walk, run or ride with the screen off. Started only from the app.
             location: with GPS (map and route). health: without GPS (distance from the step counter, or time only). -->
        <service
            android:name=".track.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location|health" />

        <!-- Digital detox Strict mode: runs only while a strict detox the member started is on; countdown always shown -->
        <service
            android:name=".detox.StrictGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started digital detox in Strict mode: covers apps the user chose to pause with a countdown screen until the time they chose" />
        </service>

        <!-- Privacy: Firebase only for pushes, and only once the member allows them. No token is created at app
             start (auto-init off), and no analytics or advertising ID collection, even if a library adds it later. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <!-- Motivation pushes from the admin (Firebase). Templates are filled on the phone. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Health Connect shows this when the user taps "privacy policy" on the permission screen -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the same screen, reached from system Health Connect settings -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: nothing from this app goes to Google Drive backups or is copied to a new phone by Android's
     transfer tool. Diary, goals, detox history and health numbers stay on this phone. (Members who want a backup
     can turn on "Sync my goals, diary and detox" in Profile, which they control and can delete.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
